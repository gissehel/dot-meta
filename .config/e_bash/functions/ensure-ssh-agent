SSH_ENV="$HOME/.ssh/environment"

function start_agent {
     echo "Initialising new SSH agent..."
     /usr/bin/ssh-agent | sed 's/^echo/#echo/' > "${SSH_ENV}"
     echo succeeded
     chmod 600 "${SSH_ENV}"
     . "${SSH_ENV}" > /dev/null
     /usr/bin/ssh-add;
}

# Source SSH settings, if applicable

function ensure-ssh-agent {
    if [ -f "${SSH_ENV}" ]; then
        . "${SSH_ENV}" > /dev/null
        if [ $(ps auxw | grep " ${SSH_AGENT_PID} " | grep ssh-agent | wc -l) != "1" ]
        then
        {
            killall ssh-agent
            start_agent;
        }
        fi
    else
        start_agent;
    fi
}

