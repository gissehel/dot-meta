SSH_ENV="$HOME/.ssh/environment"

function start_agent {
     echo "Initialising new SSH agent..."
     /usr/bin/ssh-agent | sed 's/^echo/#echo/' > "${SSH_ENV}"
     echo succeeded
     chmod 600 "${SSH_ENV}"
     . "${SSH_ENV}" > /dev/null
     /usr/bin/ssh-add;
}

# Source SSH settings, if applicable

function ensure-ssh-agent {
    if [ -f "${SSH_ENV}" ]; then
        . "${SSH_ENV}" > /dev/null
        if [ "$(ssh-add -l 2>&1 | grep "connecting to agent" >/dev/null && echo "ok" || echo "ko")" == "ok" ]
        then
        {
            /bin/rm -f "${SSH_ENV}"
            killall ssh-agent
            start_agent;
            . "${SSH_ENV}" > /dev/null
        }
        fi

        if [ "$(ssh-add -l >/dev/null 2>&1 && echo "ok" || echo "ko")" == "ko" ]
        then
        {
            ssh-add
        }
        fi
    else
        start_agent;
    fi
}

